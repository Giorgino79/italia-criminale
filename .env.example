# Copiare in .env e modificare
DEBUG=True
SECRET_KEY=cambiami-con-una-stringa-lunga-e-casuale
ALLOWED_HOSTS=localhost,127.0.0.1
# DATABASE_URL=postgres://utente:password@localhost:5432/italia_criminale

# Raccolta: User-Agent con un contatto, come buona pratica verso le testate
RACCOLTA_USER_AGENT=ItaliaCriminaleBot/0.1 (+mailto:tuo@indirizzo.it)
CONSERVA_TESTO_GIORNI=7

# Estrazione con LLM (senza chiave si usa il classificatore a parole chiave)
ANTHROPIC_API_KEY=
LLM_MODELLO=claude-sonnet-5-5

GEOCODING_USER_AGENT=ItaliaCriminale/0.1 (tuo@indirizzo.it)
NOMINATIM_URL=nominatim.openstreetmap.org

# Avviso email per le segnalazioni di errore
SEGNALAZIONI_EMAIL=
